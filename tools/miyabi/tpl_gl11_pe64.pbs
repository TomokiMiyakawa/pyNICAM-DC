#!/bin/bash -l
#PBS -l select=64:mpiprocs=1
#PBS -l walltime=00:50:00
#PBS -W group_list=gj37
#PBS -N pnc_gl11
#PBS -j oe
# Miyabi production benchmark template: gl11rl03 pe64 fp32 z40, full stack
# (resident + FUSE_TIMELOOP jit chunk + NCCL-FFI halo transport).
# Reference: 0.30 s/step steady (fastest-100 chunk mean; first chunk = compile).
# Needs the hires inputs + config generator (see PORT.md "Datasets"): set HIRES
# below to the pynicam-sweep/hires directory holding make_hires_config.py.
# Submit FROM the repo root:
#   qsub -q regular-g -v PYNICAM_VENV=...,HIRES_ROOT=... tools/miyabi/tpl_gl11_pe64.pbs
set -uo pipefail
cd "$PBS_O_WORKDIR"                      # = repo root
G=11; RL=3; PE=64; LSTEP=30
CODE="$PBS_O_WORKDIR"
[ -f "$CODE/pynicamdc/nhm/driver/driver-dc.py" ] || { echo "ERROR: submit from the repo root" >&2; exit 2; }
VENV="${PYNICAM_VENV:?set PYNICAM_VENV (qsub -v)}"
ROOT="${HIRES_ROOT:?set HIRES_ROOT=/path/to/pynicam-sweep (qsub -v)}"; HIRES="$ROOT/hires"
module load nvidia/25.9; source "$VENV/bin/activate"
source "$CODE/tools/miyabi/env.sh"
echo "### gl${G}rl0${RL} pe${PE} benchmark (code @$(git -C "$CODE" rev-parse --short HEAD)) ###"
DRV="$CODE/pynicamdc/nhm/driver/driver-dc.py"

LAB=bench
python "$HIRES/make_hires_config.py" --gl "$G" --rl "$RL" --pe "$PE" \
    --vlayer 40 --vgrid vgrid40_stretch_45km.json \
    --backend jax --precision float32 --lstep "$LSTEP" --label "$LAB" >/dev/null 2>&1
RD="$ROOT/run/gl${G}rl0${RL}_${LAB}"
sed -i 's/^PRGout_interval=.*/PRGout_interval=1000/' "$RD/nhm_driver.toml" 2>/dev/null || true

( cd "$RD"; rm -rf out* *.zarr msg.pe*
  source "$CODE/config/production.env"
  export XLA_FLAGS="--xla_gpu_autotune_level=0"
  export PYNICAM_COMM_NO_BARRIER=1
  # CHUNK=4/WARMUP=3 kept DELIBERATELY (S3): the historical-comparability
  # protocol (lstep 43 = 3 + 40; every recorded s/step uses it). Since S2 the
  # resolver default is cap=1 -> K=1, warm-up=K; this opts into the legacy values.
  export PYNICAM_FUSE_TIMELOOP=1 PYNICAM_TIMELOOP_JIT=1 PYNICAM_TIMELOOP_CHUNK=4 PYNICAM_TIMELOOP_WARMUP=3
  export PYNICAM_PROFILE=timeloop_timing
  unset OMPI_MCA_mca_base_env_list
  X=(--mca coll ^hcoll -x PATH -x LD_LIBRARY_PATH -x PYTHONPATH)
  for v in $(compgen -v | grep -E '^(PYNICAM_|MPI4JAX_|XLA_PYTHON_|XLA_FLAGS|HCOLL_ENABLE|JAX_PLATFORMS|NCCL_)'); do X+=(-x "$v"); done
  timeout -k 30 2400 mpirun "${X[@]}" -np "$PE" /usr/bin/time -v python "$DRV" \
      --driver-setting ./driversettings.toml < /dev/null > "$PBS_O_WORKDIR/${LAB}.log" 2>&1 )

echo "done=$(grep -c 'peacefully done' "${LAB}.log")/$PE"
echo "host MaxRSS (KB) median-ish: $(grep -h 'Maximum resident set size' "${LAB}.log" | awk '{print $NF}' | sort -rn | sed -n "$((PE/2))p")"
grep -h "TIMELOOP_CHUNK" "${LAB}.log" | awk '{gsub(/wall=|s$/,"",$4); print $4}' | \
  sort -n | head -100 | awk '{s+=$1;n++} END{if(n>0) printf "fastest-100 chunk mean=%.4f s -> per_step=%.4f s (ref ~0.30)\n", s/n, s/n/4}'
