#!/bin/bash -l
#PBS -l select=64:mpiprocs=1
#PBS -l walltime=01:30:00
#PBS -W group_list=gj37
#PBS -N pnc_mpL2
#PBS -j oe
# MEM-PEAK M2-L2 at scale: PYNICAM_CONST_ARGS A/B, gl11 pe64 fp32 z40 (JIT=1 chunk).
# Arm A: CONST_ARGS=0 (baseline; rank0 dump = the 17.77 GiB / 5.72 GiB-constants module)
# Arm B: CONST_ARGS=1 (device_consts geometry as traced chunk-jit args)
# Measures per arm: chunk-module constant-pool bytes + total, host MaxRSS/rank,
# chunk timings (dump-perturbed -> indicative). Numerics at scale come from the
# separate no-dump A/B + toolkit; this job is the MEM attribution.
#   qsub -q regular-g mp_m2L2_z40.pbs
set -uo pipefail
cd "$PBS_O_WORKDIR"
G=11; RL=3; PE=64; LSTEP=10
CODE=/work/gj37/c24028/workforclaude/pyNICAM-DC
VENV=/work/gj37/c24028/workforclaude/venv-gh200
ROOT=/work/gj37/c24028/workforclaude/fromwhale/pynicam-sweep; HIRES="$ROOT/hires"
module load nvidia/25.9; source "$VENV/bin/activate"
NVLIBS=$(python -c "import nvidia,glob,os;b=os.path.dirname(nvidia.__file__);print(':'.join(sorted(glob.glob(b+'/*/lib'))))")
export LD_LIBRARY_PATH="$NVLIBS:${LD_LIBRARY_PATH:-}"; export PYTHONPATH="$CODE"
export PYNICAM_NCCLFFI_LIB="$CODE/tools/ncclffi/libncclffi.so"
echo "### MEM-PEAK M2-L2 z40 (code @$(git -C "$CODE" rev-parse --short HEAD)) ###"
DRV="$CODE/pynicamdc/nhm/driver/driver-dc.py"

LAB=mpL2
python "$HIRES/make_hires_config.py" --gl "$G" --rl "$RL" --pe "$PE" \
    --vlayer 40 --vgrid vgrid40_stretch_45km.json \
    --backend jax --precision float32 --lstep "$LSTEP" --label "$LAB" >/dev/null 2>&1
RD="$ROOT/run/gl${G}rl0${RL}_${LAB}"
sed -i 's/^PRGout_interval=.*/PRGout_interval=1000/' "$RD/nhm_driver.toml" 2>/dev/null || true

run_arm () {  # $1=arm  $2=CONST_ARGS
  local ARM="$1" CA="$2"
  local DUMP="$PBS_O_WORKDIR/hlo_dump_L2_$ARM"; rm -rf "$DUMP"; mkdir -p "$DUMP"
  cat > "wrap_L2_$ARM.sh" <<EOF
#!/bin/bash
R="\${OMPI_COMM_WORLD_RANK:-0}"
if [ "\$R" = "0" ]; then
  export XLA_FLAGS="--xla_gpu_autotune_level=0 --xla_dump_to=$DUMP --xla_dump_hlo_as_text"
fi
exec /usr/bin/time -v python "\$@"
EOF
  chmod +x "wrap_L2_$ARM.sh"
  ( cd "$RD"; rm -rf out* *.zarr msg.pe*
    source "$CODE/config/production.env"
    export XLA_FLAGS="--xla_gpu_autotune_level=0"
    export PYNICAM_COMM_NO_BARRIER=1
    export PYNICAM_FUSE_TIMELOOP=1 PYNICAM_TIMELOOP_JIT=1 PYNICAM_TIMELOOP_CHUNK=4 PYNICAM_TIMELOOP_WARMUP=3
    export PYNICAM_PROFILE=timeloop_timing
    export PYNICAM_CONST_ARGS="$CA"
    unset OMPI_MCA_mca_base_env_list
    X=(--mca coll ^hcoll -x PATH -x LD_LIBRARY_PATH -x PYTHONPATH)
    for v in $(compgen -v | grep -E '^(PYNICAM_|MPI4JAX_|XLA_PYTHON_|XLA_FLAGS|HCOLL_ENABLE|JAX_PLATFORMS|NCCL_)'); do X+=(-x "$v"); done
    timeout -k 30 2400 mpirun "${X[@]}" -np "$PE" "$PBS_O_WORKDIR/wrap_L2_$ARM.sh" "$DRV" \
        --driver-setting ./driversettings.toml < /dev/null > "$PBS_O_WORKDIR/${LAB}_$ARM.log" 2>&1 )
  echo "--- arm $ARM (CONST_ARGS=$CA) ---"
  echo "  done=$(grep -c 'peacefully done' "$PBS_O_WORKDIR/${LAB}_$ARM.log")/$PE"
  local MR; MR=$(ls -S "$DUMP"/*memory-usage-report* 2>/dev/null | head -1)
  echo "  largest module report: ${MR:-NONE}"
  [ -n "$MR" ] && head -2 "$MR" | tail -1
  local BA="${MR/memory-usage-report/buffer-assignment}"
  if [ -f "$BA" ]; then
    echo "  constant allocs: $(awk '/^allocation .*constant:/{split($0,a,"size ");split(a[2],b,",");s+=b[1];n++} END{printf "n=%d %.2f GiB", n, s/2^30}' "$BA")"
    echo "  temp arena: $(awk '/preallocated-temp/{split($0,a,"size ");split(a[2],b,",");printf "%.2f GiB", b[1]/2^30}' "$BA")"
  fi
  echo "  host MaxRSS (KB) top4: $(grep -h 'Maximum resident set size' "$PBS_O_WORKDIR/${LAB}_$ARM.log" | awk '{print $NF}' | sort -rn | head -4 | tr '\n' ' ')"
  echo "  host MaxRSS (KB) median-ish (rank32 of sorted): $(grep -h 'Maximum resident set size' "$PBS_O_WORKDIR/${LAB}_$ARM.log" | awk '{print $NF}' | sort -rn | sed -n '32p')"
  echo "  chunk timings (dump-perturbed):"
  grep -h "TIMELOOP_CHUNK" "$PBS_O_WORKDIR/${LAB}_$ARM.log" | awk '{print $4}' | sort | uniq -c | sort -rn | head -3
}

run_arm A 0
run_arm B 1

echo "===== (end M2-L2 z40) ====="
