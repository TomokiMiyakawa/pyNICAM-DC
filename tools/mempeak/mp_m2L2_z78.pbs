#!/bin/bash -l
#PBS -l select=80:mpiprocs=1
#PBS -l walltime=01:40:00
#PBS -W group_list=gj37
#PBS -N pnc_mpZ78
#PBS -j oe
# MEM-PEAK M2-L2 z78 HOST probe (THE campaign prize). NO XLA DUMPS AT z78 (M1
# lesson: rank0 text dump OOM-killed the host). gl11 z78 fp32, JIT=1 chunk.
#   A: pe80 CONST_ARGS=0  (clean baseline ~86.3 GiB/rank, job 2442662)
#   B: pe80 CONST_ARGS=1  (host delta from de-baking the geometry literals)
#   C: pe64 CONST_ARGS=1  (FIT TEST: z78 was memory-forced to pe80; does the
#      host drop let pe64 fit inside the 120GB Grace cgroup?)
# Measures: host MaxRSS/rank, completion, chunk timings.
#   qsub -q regular-g mp_m2L2_z78.pbs
set -uo pipefail
cd "$PBS_O_WORKDIR"
G=11; RL=3; LSTEP=10
CODE=/work/gj37/c24028/workforclaude/pyNICAM-DC
VENV=/work/gj37/c24028/workforclaude/venv-gh200
ROOT=/work/gj37/c24028/workforclaude/fromwhale/pynicam-sweep; HIRES="$ROOT/hires"
module load nvidia/25.9; source "$VENV/bin/activate"
NVLIBS=$(python -c "import nvidia,glob,os;b=os.path.dirname(nvidia.__file__);print(':'.join(sorted(glob.glob(b+'/*/lib'))))")
export LD_LIBRARY_PATH="$NVLIBS:${LD_LIBRARY_PATH:-}"; export PYTHONPATH="$CODE"
export PYNICAM_NCCLFFI_LIB="$CODE/tools/ncclffi/libncclffi.so"
echo "### MEM-PEAK M2-L2 z78 host probe (code @$(git -C "$CODE" rev-parse --short HEAD)) ###"
DRV="$CODE/pynicamdc/nhm/driver/driver-dc.py"

run_arm () {  # $1=arm  $2=PE  $3=CONST_ARGS
  local ARM="$1" PE="$2" CA="$3"
  local LAB="mpZ78_${ARM}"
  python "$HIRES/make_hires_config.py" --gl "$G" --rl "$RL" --pe "$PE" \
      --vlayer 78 --vgrid vgrid78.json \
      --backend jax --precision float32 --lstep "$LSTEP" --label "$LAB" >/dev/null 2>&1
  local RD="$ROOT/run/gl${G}rl0${RL}_${LAB}"
  sed -i 's/^PRGout_interval=.*/PRGout_interval=1000/' "$RD/nhm_driver.toml" 2>/dev/null || true
  ( cd "$RD"; rm -rf out* *.zarr msg.pe*
    source "$CODE/config/production.env"
    export XLA_FLAGS="--xla_gpu_autotune_level=0"
    export PYNICAM_COMM_NO_BARRIER=1
    export PYNICAM_FUSE_TIMELOOP=1 PYNICAM_TIMELOOP_JIT=1 PYNICAM_TIMELOOP_CHUNK=4 PYNICAM_TIMELOOP_WARMUP=3
    export PYNICAM_PROFILE=timeloop_timing
    export PYNICAM_CONST_ARGS="$CA"
    unset OMPI_MCA_mca_base_env_list
    X=(--mca coll ^hcoll -x PATH -x LD_LIBRARY_PATH -x PYTHONPATH)
    for v in $(compgen -v | grep -E '^(PYNICAM_|MPI4JAX_|XLA_PYTHON_|XLA_FLAGS|HCOLL_ENABLE|JAX_PLATFORMS|NCCL_)'); do X+=(-x "$v"); done
    timeout -k 30 2700 mpirun "${X[@]}" -np "$PE" /usr/bin/time -v python "$DRV" \
        --driver-setting ./driversettings.toml < /dev/null > "$PBS_O_WORKDIR/${LAB}.log" 2>&1 )
  echo "--- arm $ARM (pe$PE CONST_ARGS=$CA) ---"
  echo "  done=$(grep -c 'peacefully done' "$PBS_O_WORKDIR/${LAB}.log")/$PE"
  echo "  oom/kill signs: $(grep -ciE 'killed|memsw|oom|cgroup' "$PBS_O_WORKDIR/${LAB}.log" || true)"
  echo "  host MaxRSS (KB) top4: $(grep -h 'Maximum resident set size' "$PBS_O_WORKDIR/${LAB}.log" | awk '{print $NF}' | sort -rn | head -4 | tr '\n' ' ')"
  echo "  host MaxRSS (KB) median-ish: $(grep -h 'Maximum resident set size' "$PBS_O_WORKDIR/${LAB}.log" | awk '{print $NF}' | sort -rn | sed -n "$((PE/2))p")"
  echo "  chunk walls (top3 counts):"
  grep -h "TIMELOOP_CHUNK" "$PBS_O_WORKDIR/${LAB}.log" | awk '{print $4}' | sort | uniq -c | sort -rn | head -3
}

run_arm A 80 0
run_arm B 80 1
run_arm C 64 1

echo "===== (end M2-L2 z78) ====="
