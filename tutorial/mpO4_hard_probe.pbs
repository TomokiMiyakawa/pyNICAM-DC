#!/bin/bash -l
#PBS -q debug-g
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -W group_list=gj37
#PBS -N mpO4h
#PBS -j oe
# mem-peak O4 "hard" release probe (jw-TL, 1 GPU): does dropping the jit OBJECTS
# (re-wrap raw fns) actually free the warm-up executables' device constants?
# z40 evidence: clear_cache() alone freed 0.00 GiB while the nl-scan/tracer
# modules hold 4.61+0.99 GiB of compiled-in literals (dump-verified). Read the
# FREE_WARMUP_EXECS print: before -> after bytes_in_use.
#   Arm S (soft): FREE_WARMUP_EXECS=1     (expected: no drop, control)
#   Arm H (hard): FREE_WARMUP_EXECS=hard  (the test)
#   qsub tutorial/mpO4_hard_probe.pbs   (from tutorial/)
set -uo pipefail
cd "$PBS_O_WORKDIR"
HERE="$(pwd)"
MAIN="$(cd "$HERE/.." && pwd)"
VENV="${PYNICAM_VENV:-/work/gj37/c24028/workforclaude/venv-gh200}"
module load nvidia/25.9 2>/dev/null || true
source "$VENV/bin/activate"
NVLIBS=$(python -c "import nvidia,glob,os;b=os.path.dirname(nvidia.__file__);print(':'.join(sorted(glob.glob(b+'/*/lib'))))" 2>/dev/null || true)
export LD_LIBRARY_PATH="${NVLIBS}:${LD_LIBRARY_PATH:-}"
unset OMPI_MCA_mca_base_env_list
[ -f case/golden/gw_golden_rank0.npy ] || { echo "ERROR: dataset missing" >&2; exit 2; }

run_one () {   # $1=tag  $2=FREE mode
  local tag="$1" mode="$2"
  local rundir="$HERE/runs_o4h/${tag}"
  rm -rf "$rundir"; mkdir -p "$rundir"; ln -sfn "$HERE/case" "$rundir/case"
  local X=(--mca coll ^hcoll -x PATH -x LD_LIBRARY_PATH -x PYTHONPATH)
  ( cd "$rundir"
    export PYTHONPATH="$MAIN"
    source "$MAIN/config/production.env"
    export PYNICAM_TIMELOOP_DUMP="./out" PYNICAM_COMM_NO_BARRIER=1
    export PYNICAM_FUSE_TIMELOOP=1 PYNICAM_TIMELOOP_JIT=1 PYNICAM_TIMELOOP_CHUNK=4 PYNICAM_TIMELOOP_WARMUP=3
    export PYNICAM_PROFILE=timeloop_timing
    export PYNICAM_FREE_WARMUP_EXECS="$mode"
    for v in $(compgen -v | grep -E '^(PYNICAM_|MPI4JAX_|XLA_PYTHON_|HCOLL_ENABLE|JAX_PLATFORMS)'); do X+=(-x "$v"); done
    mpirun "${X[@]}" -np 1 python "$MAIN/pynicamdc/nhm/driver/driver-dc.py" \
        --driver-setting "$HERE/drv/drv_jw_tl.toml" < /dev/null ) > "$rundir/run.log" 2>&1
  echo "--- [$tag mode=$mode] done=$(grep -c 'peacefully done' "$rundir/run.log") ---"
  grep -m1 "FREE_WARMUP_EXECS" "$rundir/run.log" | sed 's/^/  /' || echo "  (no FREE print)"
  grep -h "TIMELOOP_CHUNK" "$rundir/run.log" | awk '{print "  ", $0}' | head -3
}

echo "########## O4 hard-release probe [jw-TL, 1 GPU] ##########"
run_one soft 1
run_one hard hard
echo "===== (end O4 hard probe) ====="
